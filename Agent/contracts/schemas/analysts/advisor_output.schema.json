          "type": "string"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "data_that_would_change_ranking": {
          "items": {
            "type": "string"
          },
          "title": "Data That Would Change Ranking",
          "type": "array"
        },
        "evidence_grade": {
          "enum": [
            0,
            1,
            2,
            3,
            4
          ],
          "title": "Evidence Grade",
          "type": "integer"
        },
        "feasibility": {
          "$ref": "#/$defs/FeasibilityV2"
        },
        "impact": {
          "$ref": "#/$defs/ImpactRangeV2"
        },
        "kind": {
          "enum": [
            "intervention",
            "information_gathering"
          ],
          "title": "Kind",
          "type": "string"
        },
        "max_addressable_impact": {
          "$ref": "#/$defs/MaxAddressableImpactV2"
        },
        "monitor": {
          "items": {
            "type": "string"
          },
          "title": "Monitor",
          "type": "array"
        },
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "recovery_fraction": {
          "$ref": "#/$defs/ImpactRangeV2"
        },
        "sensitivity": {
          "title": "Sensitivity",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "trade_offs": {
          "items": {
            "type": "string"
          },
          "title": "Trade Offs",
          "type": "array"
        }
      },
      "required": [
        "action_id",
        "title",
        "kind",
        "rank",
        "max_addressable_impact",
        "recovery_fraction",
        "impact",
        "evidence_grade",
        "feasibility",
        "assumptions",
        "trade_offs",
        "sensitivity",
        "monitor",
        "data_that_would_change_ranking"
      ],
      "title": "AdvisorOptionV2",
      "type": "object"
    },
    "ArtifactRefV2": {
      "properties": {
        "artifact_id": {
