          "type": "string"
        },
        "kind": {
          "enum": [
            "chart_data",
            "table",
            "model_card"
          ],
          "title": "Kind",
          "type": "string"
        },
        "uri": {
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "uri"
      ],
      "title": "ArtifactRefV2",
      "type": "object"
    },
    "FeasibilityV2": {
      "properties": {
        "cost_class": {
          "title": "Cost Class",
          "type": "string"
        },
        "lead_time": {
          "title": "Lead Time",
          "type": "string"
        },
        "owner": {
          "title": "Owner",
          "type": "string"
        }
      },
      "required": [
        "lead_time",
        "cost_class",
        "owner"
      ],
      "title": "FeasibilityV2",
      "type": "object"
    },
    "ImpactRangeV2": {
      "properties": {
        "base": {
          "title": "Base",
          "type": "number"
        },
        "high": {
          "title": "High",
          "type": "number"
        },
        "low": {
          "title": "Low",
          "type": "number"
        }
      },
      "required": [
        "low",
        "base",
        "high"
      ],
      "title": "ImpactRangeV2",
      "type": "object"
    },
    "MaxAddressableImpactV2": {
      "properties": {
        "interval": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Interval",
          "type": "array"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "interval"
      ],
      "title": "MaxAddressableImpactV2",
      "type": "object"
    }
