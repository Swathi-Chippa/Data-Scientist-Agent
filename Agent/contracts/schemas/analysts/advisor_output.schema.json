      "type": "array"
    },
    "assumptions": {
      "items": {
        "type": "string"
      },
      "title": "Assumptions",
      "type": "array"
    },
    "contract_version": {
      "default": "2.0",
      "title": "Contract Version",
      "type": "string"
    },
    "flags": {
      "items": {
        "type": "string"
      },
      "title": "Flags",
      "type": "array"
    },
    "module": {
      "const": "advisor",
      "default": "advisor",
      "title": "Module",
      "type": "string"
    },
    "options": {
      "items": {
        "$ref": "#/$defs/AdvisorOptionV2"
      },
      "title": "Options",
      "type": "array"
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "sources": {
      "items": {
        "type": "string"
      },
      "title": "Sources",
      "type": "array"
    },
    "status": {
      "enum": [
        "ok",
        "insufficient_evidence"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "status",
    "options",
    "assumptions",
    "sources",
    "artifacts"
  ],
  "title": "AdvisorOutput",
  "type": "object"
}
